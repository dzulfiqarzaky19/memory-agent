{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "memory": {
      "type": "local",
      "command": ["docker", "exec", "-i", "memory-agent-app", "python", "memory_mcp.py"],
      "enabled": true
    },
    "codescratch": {
      "type": "local",
      "command": ["codescratch", "mcp"],
      "enabled": true,
      "environment": {
        "CODESCRATCH_ROOT": "${workspaceFolder}"
      }
    }
  }
}
