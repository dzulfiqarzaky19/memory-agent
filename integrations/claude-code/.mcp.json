{
  "mcpServers": {
    "memory": {
      "command": "docker",
      "args": ["exec", "-i", "memory-agent-app", "python", "memory_mcp.py"]
    },
    "codescratch": {
      "command": "codescratch",
      "args": ["mcp"],
      "env": {
        "CODESCRATCH_ROOT": "${workspaceFolder}"
      }
    }
  }
}
