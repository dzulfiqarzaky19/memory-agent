{
  "description": "SessionStart injects the partner pack; Stop auto-captures each turn into local memory-agent.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/partner-pack.cjs\"",
            "statusMessage": "Loading partner pack"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/auto-capture.cjs\"",
            "statusMessage": "Capturing turn to memory-agent"
          }
        ]
      }
    ]
  }
}
