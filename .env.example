# ─────────────────────────────────────────────
# memory-agent — Configuration
# Copy to .env and edit for your environment.
# ─────────────────────────────────────────────

# -- Database (PostgreSQL + pgvector via Docker) --
# The setup script and docker-compose handle this — you shouldn't need to change it.
DATABASE_URL=postgresql://postgres:localdev@localhost:5433/memory_agent

# -- Embedding Provider --
# "openai" = any OpenAI-compatible API (OpenAI, Groq, Ollama, LM Studio, etc.)
# "local"  = ONNX via sentence-transformers (no external API needed)
EMBEDDING_PROVIDER=openai

# Embedding model name (depends on your provider)
EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5@q8_0

# Vector dimensions (must match your model)
EMBEDDING_DIMENSIONS=768

# -- OpenAI-compatible API key (used by both embedding and LLM if *_API_KEY not set) --
# Set your key here, or set OPENAI_API_KEY individually below.
# If using local LM Studio, leave as "not-needed".
OPENAI_API_KEY=not-needed

# Base URL for OpenAI-compatible API (used by embedding and LLM, overridable below)
OPENAI_BASE_URL=http://127.0.0.1:1234/v1

# Override embedding API URL (defaults to OPENAI_BASE_URL)
# EMBEDDING_BASE_URL=http://127.0.0.1:1234/v1

# -- LLM Provider (for atomic fact extraction from conversations) --
# "openai" = any OpenAI-compatible API
LLM_PROVIDER=openai

# LLM model for fact extraction
LLM_MODEL=google/gemma-4-e4b

# LLM API endpoint (defaults to OPENAI_BASE_URL if not set)
# LLM_BASE_URL=http://127.0.0.1:1234/v1

# Override LLM API key (defaults to OPENAI_API_KEY)
# LLM_API_KEY=sk-...

# Max tokens for LLM extraction responses
LLM_MAX_TOKENS=4096

# -- Extraction Cadence --
# Run LLM extraction every N conversation turns (5 = every 5th exchange triggers it)
EXTRACTION_EVERY_N_TURNS=5
# Max memories extracted per batch
EXTRACTION_MAX_MEMORIES=20
# Regenerate persona summary every N new memories
PERSONA_EVERY_N_MEMORIES=50

# -- Recall --
# Strategy: "hybrid" (vector + keyword + RRF), "vector", or "keyword"
RECALL_STRATEGY=hybrid
# Max results per search
RECALL_MAX_RESULTS=10
# Minimum vector similarity threshold
RECALL_SIMILARITY_THRESHOLD=0.3
# Keyword search weight in hybrid mode
RECALL_KEYWORD_WEIGHT=0.3
# RRF fusion constant (higher = more rank democracy)
RECALL_RRF_K=60

# -- Context Compaction --
# Token threshold before compaction triggers
# COMPACT_THRESHOLD_TOKENS=50000
# Token budget for compacted output
# COMPACT_BUDGET_TOKENS=2000
# Number of recent turns to keep raw
# COMPACT_KEEP_RECENT_TURNS=3

# HTTP door
MEMORY_API_SECRET=
MEMORY_ALLOW_RELOAD=false
MEMORY_BIND_HOST=127.0.0.1
